# ==========================================
# Transaction Webhook Service Configuration
# ==========================================

# Application Settings
APP_NAME="Transaction Webhook Service"
APP_VERSION="0.1.0"
APP_ENV="development" # development | staging | production | test
LOG_LEVEL="INFO"      # DEBUG | INFO | WARNING | ERROR | CRITICAL
API_PREFIX=""

# Server Settings
HOST="0.0.0.0"
PORT=8000

# Supabase PostgreSQL Connection
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
# Examples:
# Direct connection: postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Supabase Pooler (Transaction mode): postgresql+psycopg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql+psycopg://postgres:your_password_here@db.your_project_ref.supabase.co:5432/postgres?sslmode=require"

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
